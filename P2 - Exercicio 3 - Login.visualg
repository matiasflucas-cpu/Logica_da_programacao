algoritmo "login"
var
   senha, tentativa: caractere

inicio
   senha <- "senha123"

   escreva("Digite a senha: ")
   leia(tentativa)

   enquanto tentativa <> senha faca
      escreval("Senha incorreta. Tente novamente.")
      escreva("Digite a senha: ")
      leia(tentativa)
   fimenquanto

   escreval("Senha correta! Bem-vindo!")

fimalgoritmo