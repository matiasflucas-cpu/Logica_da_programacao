algoritmo "menu_lanchonete"

var
   codigo: inteiro
   total: real

inicio

   total <- 0
   codigo <- 0

   enquanto codigo <> 5 faca

      escreval("===== MENU DA LANCHONETE =====")
      escreval("1 - Cachorro Quente (R$ 8,00)")
      escreval("2 - Hambúrguer (R$ 15,00)")
      escreval("3 - Misto Quente (R$ 10,00)")
      escreval("4 - Refrigerante (R$ 5,00)")
      escreval("5 - Finalizar Compra")

      escreval("Digite o código do item: ")
      leia(codigo)

      escolha codigo

         caso 1
            escreval("Cachorro Quente adicionado!")
            total <- total + 8

         caso 2
            escreval("Hambúrguer adicionado!")
            total <- total + 15

         caso 3
            escreval("Misto Quente adicionado!")
            total <- total + 10

         caso 4
            escreval("Refrigerante adicionado!")
            total <- total + 5

         caso 5
            interrompa

         outrocaso
            escreval("Código inválido!")

      fimescolha

      escreval(" ")

   fimenquanto

   escreval("Compra finalizada!")
   escreval("Valor total: R$ ", total)

fimalgoritmo